GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# memory | firestore
ORGMIND_STORE=memory
# Firestore database name (only used when ORGMIND_STORE=firestore)
ORGMIND_FIRESTORE_DATABASE=(default)
# vertex | fake  (defaults to vertex when GOOGLE_CLOUD_PROJECT is set, else fake)
ORGMIND_LLM=vertex
ORGMIND_CHAT_MODEL=gemini-2.5-flash
ORGMIND_EMBED_MODEL=gemini-embedding-001
ORGMIND_CLUSTER_THRESHOLD=0.88
ORGMIND_RETRIEVAL_THRESHOLD=0.62
# cloudtrace | off. cloudtrace exports OpenTelemetry spans via OTLP to the Telemetry API (Cloud Trace)
ORGMIND_TRACING=off
# Max recorded LLM calls kept for the in-app Traces view
ORGMIND_TRACE_CAP=500
# Required header value for POST /api/demo/reset; reset is disabled when empty
ORGMIND_ADMIN_TOKEN=change-me
# Document RAG: vertex (GCS + Vertex AI Search) | fake (in-memory) | off (default: app behaves as before)
ORGMIND_RAG_PROVIDER=off
ORGMIND_RAG_DATASTORE=orgmind-rag-datastore_1792251536297
ORGMIND_RAG_BUCKET=orgmind-rag-docs-arched-jetty
ORGMIND_RAG_LOCATION=global
# Results under this semanticRelevanceScore are treated as "not covered"
ORGMIND_RAG_MIN_SCORE=0.5
